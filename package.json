{
  "name": "boklock",
  "version": "1.0.11",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "android": "cross-env ENVFILE=.env.development react-native run-android --mode=devDebug --appId=com.boklock.m.test",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "iconfont": "iconfont-rn && node scripts/generate-iconfont-ttf.js && node scripts/generate-harmony-icons.js",
    "test": "jest",
    "podInstall": "cd ios && pod install && cd ..",
    "gradlew:clean": "cd android && ./gradlew clean && cd ..",
    "gradlew:clean:win": "cd android && gradlew.bat clean && cd ..",
    "watch:android": "cross-env ENVFILE=.env.development react-native run-android --mode=devDebug --appId=com.boklock.m.test",
    "watch:ios": "cross-env ENVFILE=.env.development react-native run-ios",
    "dev:android": "cross-env ENVFILE=.env.development react-native run-android --mode=devDebug --appId=com.boklock.m.test",
    "dev:android:release": "cross-env ENVFILE=.env.development react-native run-android --mode=devRelease",
    "dev:ios": "cross-env ENVFILE=.env.development react-native run-ios",
    "dev:apk": "cross-env ENVFILE=.env.development cd android && ./gradlew assembleDevRelease && cd ..",
    "dev:apk:win": "cross-env ENVFILE=.env.development cd android && gradlew.bat assembleDevRelease && cd ..",
    "dev:bundle:android": "cross-env ENVFILE=.env.development react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "sync:harmony:sign": "node scripts/sync-harmony-signing.cjs",
    "dev:harmony": "cross-env ENVFILE=.env.development node scripts/generate-harmony-env.js && cross-env ENVFILE=.env.development react-native bundle-harmony --dev",
    "link:harmony": "node ./node_modules/@react-native-community/cli/build/index.js link-harmony --harmony-project-path ..\\DevEcoStudioProjects\\boke_harmony --ets-rnoh-packages-factory-path-relative-to-harmony ./entry/src/main/ets/autogen/RNOHPackagesFactory.ets",
    "real:android": "cross-env ENVFILE=.env.production react-native run-android --mode=prodDebug --appId=com.boklock.m",
    "real:android:release": "cross-env ENVFILE=.env.production react-native run-android --mode=prodRelease",
    "real:ios": "cross-env ENVFILE=.env.production react-native run-ios --configuration Release",
    "real:apk": "cross-env ENVFILE=.env.production cd android && ./gradlew assembleProdRelease && cd ..",
    "real:apk:win": "cross-env ENVFILE=.env.production cd android && gradlew.bat assembleProdRelease && cd ..",
    "real:bundle:android": "cross-env ENVFILE=.env.production react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "real:harmony": "cross-env ENVFILE=.env.production node scripts/generate-harmony-env.js && cross-env ENVFILE=.env.production react-native bundle-harmony",
    "staging:android": "cross-env ENVFILE=.env.staging react-native run-android --mode=devDebug --appId=com.boklock.m.test",
    "staging:ios": "cross-env ENVFILE=.env.staging react-native run-ios",
    "staging:apk": "cross-env ENVFILE=.env.staging cd android && ./gradlew assembleDevRelease && cd ..",
    "build:dev:apk": "./build.sh dev:apk",
    "build:dev:apk:win": "powershell -NoProfile -Command \"$v=(Get-Date).ToString('yyyyMMddHHmmss'); $env:NODE_ENV='production'; $env:DEPLOY_ENV='dev'; $env:DEPLOY_VERSION=$v; Copy-Item .env.dev .env -Force; Set-Location android; if (Test-Path .\\app\\build) { Remove-Item .\\app\\build -Recurse -Force }; ./gradlew.bat clean; ./gradlew.bat assembleDevRelease -PDEPLOY_ENV=dev -PDEPLOY_VERSION=$v; $apk=(Get-ChildItem -Path .\\app\\build\\outputs -Filter *.apk -Recurse | Sort-Object LastWriteTime -Descending | Select-Object -First 1).FullName; if (-not $apk) { throw 'No APK found after build' }; $env:FASTLANE_APK_PATH=$apk; Write-Host \"Using APK: $apk\"; $env:LANG='en_US.UTF-8'; $env:LC_ALL='en_US.UTF-8'; $env:RUBYOPT='-EUTF-8'; if (Test-Path Gemfile) { bundle install }; bundle exec fastlane android upload_to_pgyer_dev; Set-Location ..\"",
    "build:dev:ios": "./build.sh dev:ios",
    "ios:env:dev": "sh -c 'echo .env.development > /tmp/envfile && echo \"[ios env] /tmp/envfile -> .env.development\"'",
    "ios:env:real": "sh -c 'echo .env.production > /tmp/envfile && echo \"[ios env] /tmp/envfile -> .env.production\"'",
    "ios:env:clear": "sh -c 'rm -f /tmp/envfile && echo \"[ios env] cleared /tmp/envfile\"'",
    "build:dev:ios:prep": "pnpm run ios:env:dev && pnpm run build:dev:ios",
    "build:real:apk": "./build.sh real:apk",
    "build:real:apk:win": "powershell -NoProfile -Command \"$v=(Get-Date).ToString('yyyyMMddHHmmss'); $env:NODE_ENV='production'; $env:DEPLOY_ENV='real'; $env:DEPLOY_VERSION=$v; Copy-Item .env.real .env -Force; Set-Location android; if (Test-Path .\\app\\build) { Remove-Item .\\app\\build -Recurse -Force }; ./gradlew.bat clean; ./gradlew.bat assembleProdRelease -PDEPLOY_ENV=real -PDEPLOY_VERSION=$v; $apk=(Get-ChildItem -Path .\\app\\build\\outputs -Filter *.apk -Recurse | Sort-Object LastWriteTime -Descending | Select-Object -First 1).FullName; if (-not $apk) { throw 'No APK found after build' }; $env:FASTLANE_APK_PATH=$apk; Write-Host \"Using APK: $apk\"; $env:LANG='en_US.UTF-8'; $env:LC_ALL='en_US.UTF-8'; $env:RUBYOPT='-EUTF-8'; if (Test-Path Gemfile) { bundle install }; bundle exec fastlane android upload_to_pgyer_real; Set-Location ..\"",
    "build:real:ios": "./build.sh real:ios",
    "build:real:ios:prep": "pnpm run ios:env:real && pnpm run build:real:ios",
    "build:staging:apk": "./build.sh staging:apk",
    "build:staging:ios": "./build.sh staging:ios",
    "generate:harmony-icons": "node scripts/generate-harmony-icons.js",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@ant-design/icons-react-native": "^2.3.2",
    "@ant-design/react-native": "^5.4.3",
    "@babel/runtime": "^7.18.9",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^1.17.11",
    "@react-native-clipboard/clipboard": "1.16.3",
    "@react-native-community/netinfo": "^9.3.10",
    "@react-native-community/segmented-control": "^2.2.2",
    "@react-native-community/slider": "^4.4.2",
    "@react-native-oh-tpl/react-native-linear-gradient": "3.0.0-0.5.0",
    "@react-native-oh-tpl/react-native-view-shot": "3.8.0-0.3.2",
    "@react-native-oh-tpl/react-native-haptic-feedback": "2.2.1-rc.1",
    "@react-native-oh-tpl/react-native-webview": "13.10.4",
    "@react-native-ohos/clipboard": "1.16.3-rc.1",
    "@react-native-ohos/react-native-ble-plx": "3.2.1-rc.2",
    "@react-native-ohos/react-native-image-picker": "7.0.4-rc.2",
    "@react-native-ohos/react-native-video": "5.2.4-rc.1",
    "@react-native-ohos/react-native-vision-camera": "4.0.3",
    "@react-navigation/bottom-tabs": "^6.5.7",
    "@react-navigation/native": "^6.1.6",
    "@react-navigation/native-stack": "^6.9.12",
    "@react-navigation/stack": "^6.3.16",
    "@tanstack/react-query": "^4.29.19",
    "@types/crypto-js": "^4.2.2",
    "axios": "^1.1.3",
    "buffer": "^6.0.3",
    "cos-js-sdk-v5": "^1.10.1",
    "crypto-js": "^4.2.0",
    "element-china-area-data": "^6.1.0",
    "eventemitter3": "^5.0.4",
    "execa": "^9.6.1",
    "iconv-lite": "^0.7.2",
    "jotai": "^2.18.0",
    "react": "18.2.0",
    "react-native": "0.72.5",
    "react-native-amap-geolocation": "^1.2.3",
    "react-native-amap3d": "^3.2.4",
    "react-native-ble-plx": "3.5.0",
    "react-native-calendars": "^1.1314.0",
    "react-native-config": "1.5.1",
    "react-native-cos-sdk": "^1.2.1",
    "react-native-date-picker": "^5.0.13",
    "react-native-device-info": "^9.0.2",
    "react-native-exit-app": "^2.0.0",
    "react-native-fast-image": "^8.6.3",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "2.9.0",
    "react-native-gif-player": "^1.0.2",
    "react-native-haptic-feedback": "3.0.0",
    "react-native-iconfont-cli": "^2.2.4",
    "react-native-image-picker": "^4.10.0",
    "react-native-intent-launcher": "^0.2.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-permissions": "^3.8.0",
    "react-native-reanimated": "3.10.1",
    "react-native-reanimated-carousel": "^4.0.3",
    "react-native-restart": "^0.0.27",
    "react-native-safe-area-context": "^4.4.1",
    "react-native-screens": "3.18.2",
    "react-native-svg": "13.10.0",
    "react-native-video": "^5.2.1",
    "react-native-view-shot": "^3.8.0",
    "react-native-vision-camera": "4.0.0",
    "react-native-webview": "^11.26.1",
    "react-native-wechat-lib": "^3.0.4",
    "react-native-zip-archive": "^6.0.0",
    "rn-fetch-blob": "^0.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.18.10",
    "@babel/plugin-transform-runtime": "^7.18.10",
    "@babel/preset-env": "^7.18.10",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.18.6",
    "@react-native-community/cli": "^10.2.0",
    "@react-native-community/cli-platform-android": "^10.2.0",
    "@react-native-community/cli-platform-ios": "^10.2.0",
    "@react-native-oh/react-native-harmony": "0.72.116-2",
    "@react-native-oh/react-native-harmony-cli": "0.77.50",
    "@react-native/metro-config": "0.76.8",
    "@react-native/typescript-config": "0.73.1",
    "@types/jest": "^29.0.3",
    "@types/react": "^18.0.18",
    "@types/react-test-renderer": "^18.0.0",
    "@types/xdate": "^0.8.35",
    "babel-plugin-module-resolver": "^5.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.23.0",
    "eslint-plugin-react": "^7.31.8",
    "eslint-plugin-react-native": "^4.0.0",
    "jest": "^29.0.3",
    "metro-react-native-babel-preset": "0.76.8",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "18.2.0",
    "sharp": "^0.34.5",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=16.0.0 <21.0.0"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  },
  "pnpm": {
    "patchedDependencies": {
      "@react-native-ohos/react-native-vision-camera@4.0.3": "patches/@react-native-ohos+react-native-vision-camera@4.0.3.patch",
      "react-native-amap3d": "patches/react-native-amap3d.patch",
      "react-native-intent-launcher": "patches/react-native-intent-launcher.patch",
      "react-native-wechat-lib": "patches/react-native-wechat-lib.patch",
      "react-native-screens@3.18.2": "patches/react-native-screens@3.18.2.patch",
      "metro-file-map@0.76.8": "patches/metro-file-map@0.76.8.patch",
      "react-native@0.72.5": "patches/react-native@0.72.5.patch",
      "@react-native-ohos/react-native-ble-plx@3.2.1-rc.2": "patches/@react-native-ohos+react-native-ble-plx@3.2.1-rc.2.patch",
      "react-native-haptic-feedback@3.0.0": "patches/react-native-haptic-feedback@3.0.0.patch"
    },
    "overrides": {
      "@react-native-oh/react-native-harmony-cli": "0.77.50",
      "@react-native-oh/react-native-harmony>@react-native-oh/react-native-harmony-cli": "0.77.50"
    }
  }
}
