{
  "extends": "@tsconfig/react-native/tsconfig.json",
  "compilerOptions": {
    "jsx": "react",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@style": ["src/style"],
      "@types": ["src/types"],
      "@types/*": ["src/types/*"],
      "@utils": ["src/utils"],
      "@utils/*": ["src/utils/*"],
      "@i18n": ["src/i18n"],
      "@components/*": ["src/components/*"],
      "@basicComponents/*": ["src/components/basic/*"],
      "@businessComponents/*": ["src/components/business/*"],
      "@assets/*": ["src/assets/*"],
      "@services/": ["src/services/"],
      "@services/*": ["src/services/*"]
    },
    "lib": [
      "es2019",
      "es2020.bigint",
      "es2020.date",
      "es2020.number",
      "es2020.promise",
      "es2020.string",
      "es2020.symbol.wellknown",
      "es2021.promise",
      "es2021.string",
      "es2021.weakref",
      "es2022.array",
      "es2022.object",
      "es2022.string",
      "DOM"
    ]
  }
}
