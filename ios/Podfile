require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

require_relative '../node_modules/react-native-permissions/scripts/setup'

platform :ios, '15.5'
prepare_react_native_project!

setup_permissions([
  'BluetoothPeripheral',
  'BluetoothAlways',
  'Camera',
  'LocationWhenInUse',
  'LocationAlways',
  'PhotoLibrary',
  'PhotoLibraryAddOnly',
  'Microphone',
  'Motion',
  'Contacts',
])

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

ENV['QCloudSDK_IOS_GIT'] = "https://ghproxy.com/https://github.com/tencentyun/qcloud-sdk-ios.git"

target 'boklock' do
  # 与 RNZipArchive 保持一致，避免 SSZipArchive 版本冲突
  pod 'SSZipArchive', '2.2.3'
  # 微信开放平台官方 SDK，提供 BaseReq 等实现，供 react-native-wechat-lib 链接使用
  pod 'WechatOpenSDK'
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => false,
    :fabric_enabled => false,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )

    # Set minimum deployment target to 15.5 for all pods (required by RNZipArchive)
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'

        # Fix for RNZipArchive compilation issue - remove unsupported -G flag
        if target.name == 'RNZipArchive'
          if build_config.build_settings['OTHER_CFLAGS']
            flags = build_config.build_settings['OTHER_CFLAGS']
            if flags.is_a?(String)
              build_config.build_settings['OTHER_CFLAGS'] =
                flags.gsub(/\s*-G\s*/, ' ').strip
            elsif flags.is_a?(Array)
              build_config.build_settings['OTHER_CFLAGS'] =
                flags.reject { |flag| flag.strip == '-G' }
            end
          end
          if build_config.build_settings['OTHER_CPLUSPLUSFLAGS']
            flags = build_config.build_settings['OTHER_CPLUSPLUSFLAGS']
            if flags.is_a?(String)
              build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] =
                flags.gsub(/\s*-G\s*/, ' ').strip
            elsif flags.is_a?(Array)
              build_config.build_settings['OTHER_CPLUSPLUSFLAGS'] =
                flags.reject { |flag| flag.strip == '-G' }
            end
          end
        end
      end
      # 清除 RNZipArchive.m 的 per-file Compiler Flags，避免 -GCC_PREPROCESSOR_DEFINITIONS 被拆成 -G 导致 unsupported option '-G'
      if target.name == 'RNZipArchive'
        target.source_build_phase.files.each do |bf|
          path = bf.file_ref&.path || bf.file_ref&.real_path&.to_s || ''
          next unless path.end_with?('RNZipArchive.m')
          bf.settings ||= {}
          if bf.settings['COMPILER_FLAGS'].to_s.include?('-G')
            bf.settings['COMPILER_FLAGS'] = ''
          end
        end
      end
    end

    # 允许 QCloudTrack 使用私有头文件
    installer.pods_project.targets.each do |target|
      if target.name == 'QCloudTrack'
        target.build_configurations.each do |build_config|
          # 对 QCloudTrack 的私有头文件警告进行降级处理
          other_cflags = build_config.build_settings['OTHER_CFLAGS'] || ''
          if other_cflags.is_a?(String)
            build_config.build_settings['OTHER_CFLAGS'] = other_cflags + ' -Wno-error=private-header -Wno-private-header'
          elsif other_cflags.is_a?(Array)
            build_config.build_settings['OTHER_CFLAGS'] = other_cflags + ['-Wno-error=private-header', '-Wno-private-header']
          end
        end
      end
    end

    # 允许 QCloudCore 使用私有头文件
    installer.pods_project.targets.each do |target|
      if target.name == 'QCloudCore'
        target.build_configurations.each do |build_config|
          # 对 QCloudCore 的私有头文件警告进行降级处理
          other_cflags = build_config.build_settings['OTHER_CFLAGS'] || ''
          if other_cflags.is_a?(String)
            build_config.build_settings['OTHER_CFLAGS'] = other_cflags + ' -Wno-error=private-header -Wno-private-header'
          elsif other_cflags.is_a?(Array)
            build_config.build_settings['OTHER_CFLAGS'] = other_cflags + ['-Wno-error=private-header', '-Wno-private-header']
          end
        end
      end
    end

    # 补丁：RCT-Folly Time.h 在 Apple 上不重定义 clockid_t，避免与系统 enum clockid_t 冲突
    time_h_path = File.join(installer.config.installation_root, 'Pods', 'Headers', 'Private', 'RCT-Folly', 'folly', 'portability', 'Time.h')
    if File.exist?(time_h_path)
      content = File.read(time_h_path)
      if content.include?('typedef uint8_t clockid_t;') && !content.include?('#if !defined(__APPLE__)')
        content.gsub!(
          /^(\s*)typedef uint8_t clockid_t;\s*$/,
          "\\1#if !defined(__APPLE__)\n\\1typedef uint8_t clockid_t;\n\\1#endif\n"
        )
        File.write(time_h_path, content)
        Pod::UI.puts '[Podfile] Patched RCT-Folly folly/portability/Time.h for Apple clockid_t'.green
      end
    end

    # iPhoneOS26.4 SDK: 直接 include netinet6/in6.h 会触发 #error
    # 修复策略：确保有 netinet/in.h，同时删除源码里的 netinet6/in6.h include/import。
    qcloud_netinet_patch = lambda do |relative_path|
      qcloud_path = File.join(installer.config.installation_root, 'Pods', relative_path)
      next unless File.exist?(qcloud_path)

      content = File.read(qcloud_path)
      has_in6 = content.include?('netinet6/in6.h')
      next unless has_in6

      has_in = content.include?('#import <netinet/in.h>') || content.include?('#include <netinet/in.h>')

      unless has_in
        # 在首次 in6 include/import 之前插入 netinet/in.h
        content.sub!(/(#\s*(?:import|include)\s*<netinet6\/in6\.h>\s*\n)/,
          "#import <netinet/in.h>\n\\1"
        )
      end

      # 删除 netinet6/in6.h 的 include/import 行
      content.gsub!(/^\s*#\s*(?:import|include)\s*<netinet6\/in6\.h>\s*\n/m, '')

      # 部分环境下 Pods 源文件可能是只读（例如 r--r--r--），确保能写回
      begin
        File.chmod(0o644, qcloud_path)
      rescue StandardError
        # ignore
      end

      File.write(qcloud_path, content)
      Pod::UI.puts "[Podfile] Patched netinet include: #{relative_path}".green
    end

    qcloud_netinet_patch.call('QCloudTrack/QCloudTrack/Classes/Default/Utils/QCloudTrackNetworkUtils.m')
    qcloud_netinet_patch.call('QCloudCore/QCloudCore/Classes/Base/QCLOUDRestNet/reachability/QCloudReachability.m')

    # 修复 RNAudioRecorderPlayer：AAC 录音误带 PCM 参数导致 iOS record() 失败
    recorder_swift = File.join(
      installer.config.installation_root,
      '..',
      'node_modules',
      'react-native-audio-recorder-player',
      'ios',
      'RNAudioRecorderPlayer.swift',
    )
    if File.exist?(recorder_swift)
      content = File.read(recorder_swift)
      original = content.dup

      unless content.include?('URL(fileURLWithPath: String(path.dropFirst("file://".count)))')
        content.gsub!(
          '        } else if (path.hasPrefix("http://") || path.hasPrefix("https://") || path.hasPrefix("file://")) {
            audioFileURL = URL(string: path)
        } else {',
          '        } else if (path.hasPrefix("http://") || path.hasPrefix("https://")) {
            audioFileURL = URL(string: path)
        } else if (path.hasPrefix("file://")) {
            audioFileURL = URL(fileURLWithPath: String(path.dropFirst("file://".count)))
        } else {',
        )
      end

      if content.include?('AVLinearPCMBitDepthKey: avLPCMBitDepth ?? AVLinearPCMBitDepthKey.count')
        content.gsub!(
          /        func startRecording\(\) \{\n            let settings = \[\n                AVSampleRateKey: sampleRate!,\n                AVFormatIDKey: avFormat,\n                AVNumberOfChannelsKey: numberOfChannel!,\n                AVEncoderAudioQualityKey: audioQuality!,\n                AVLinearPCMBitDepthKey: avLPCMBitDepth \?\? AVLinearPCMBitDepthKey\.count,\n                AVLinearPCMIsBigEndianKey: avLPCMIsBigEndian \?\? true,\n                AVLinearPCMIsFloatKey: avLPCMIsFloatKey \?\? false,\n                AVLinearPCMIsNonInterleaved: avLPCMIsNonInterleaved \?\? false,\n                 AVEncoderBitRateKey: bitRate!\n            \] as \[String : Any\]\n\n            do \{\n                audioRecorder = try AVAudioRecorder\(url: audioFileURL!, settings: settings\)\n\n                if \(audioRecorder != nil\) \{\n                    audioRecorder\.prepareToRecord\(\)\n                    audioRecorder\.delegate = self\n                    audioRecorder\.isMeteringEnabled = _meteringEnabled\n                    let isRecordStarted = audioRecorder\.record\(\)\n\n                    if !isRecordStarted \{\n                        reject\("RNAudioPlayerRecorder", "Error occured during initiating recorder", nil\)\n                        return\n                    \}/m,
          <<~SWIFT.chomp
            func startRecording() {
                if (audioRecorder != nil) {
                    audioRecorder.stop()
                    audioRecorder = nil
                }

                if let fileURL = audioFileURL, FileManager.default.fileExists(atPath: fileURL.path) {
                    try? FileManager.default.removeItem(at: fileURL)
                }

                var settings: [String: Any] = [
                    AVSampleRateKey: sampleRate!,
                    AVFormatIDKey: avFormat,
                    AVNumberOfChannelsKey: numberOfChannel!,
                    AVEncoderAudioQualityKey: audioQuality!,
                    AVEncoderBitRateKey: bitRate!
                ]

                if avFormat == kAudioFormatLinearPCM || avFormat == kAudioFormatAppleIMA4 {
                    settings[AVLinearPCMBitDepthKey] = avLPCMBitDepth ?? 16
                    settings[AVLinearPCMIsBigEndianKey] = avLPCMIsBigEndian ?? false
                    settings[AVLinearPCMIsFloatKey] = avLPCMIsFloatKey ?? false
                    settings[AVLinearPCMIsNonInterleaved] = avLPCMIsNonInterleaved ?? false
                }

                do {
                    audioRecorder = try AVAudioRecorder(url: audioFileURL!, settings: settings)

                    if (audioRecorder != nil) {
                        audioRecorder.delegate = self
                        audioRecorder.isMeteringEnabled = _meteringEnabled

                        if !audioRecorder.prepareToRecord() {
                            audioRecorder = nil
                            reject("RNAudioPlayerRecorder", "Error occured during initiating recorder", nil)
                            return
                        }

                        let isRecordStarted = audioRecorder.record()

                        if !isRecordStarted {
                            audioRecorder.stop()
                            audioRecorder = nil
                            reject("RNAudioPlayerRecorder", "Error occured during initiating recorder", nil)
                            return
                        }
          SWIFT
        )
      end

      content.gsub!(
        'try audioSession.setActive(true)',
        'try audioSession.setActive(true, options: .notifyOthersOnDeactivation)',
      ) unless content.include?('notifyOthersOnDeactivation')

      unless content.include?('sessionOptions.insert(AVAudioSession.CategoryOptions(rawValue: 128))')
        content.gsub!(
          'try audioSession.setCategory(.playAndRecord, mode: avMode, options: [AVAudioSession.CategoryOptions.defaultToSpeaker, AVAudioSession.CategoryOptions.allowBluetooth])',
          <<~SWIFT.chomp
            var sessionOptions: AVAudioSession.CategoryOptions = [.defaultToSpeaker, .allowBluetooth]
            if #available(iOS 13.0, *) {
                sessionOptions.insert(AVAudioSession.CategoryOptions(rawValue: 128))
            }
            try audioSession.setCategory(.playAndRecord, mode: avMode, options: sessionOptions)
          SWIFT
        )
        content.gsub!(
          'try audioSession.setCategory(.playAndRecord, mode: avMode, options: [AVAudioSession.CategoryOptions.defaultToSpeaker, AVAudioSession.CategoryOptions.allowBluetooth, AVAudioSession.CategoryOptions.allowHapticsAndSystemSoundsDuringRecording])',
          <<~SWIFT.chomp
            var sessionOptions: AVAudioSession.CategoryOptions = [.defaultToSpeaker, .allowBluetooth]
            if #available(iOS 13.0, *) {
                sessionOptions.insert(AVAudioSession.CategoryOptions(rawValue: 128))
            }
            try audioSession.setCategory(.playAndRecord, mode: avMode, options: sessionOptions)
          SWIFT
        )
      end

      if content != original
        File.write(recorder_swift, content)
        Pod::UI.puts '[Podfile] Patched RNAudioRecorderPlayer.swift'.green
      else
        Pod::UI.puts '[Podfile] RNAudioRecorderPlayer.swift patch OK'.green
      end
    end

    installer.pods_project.save
  end
end

target 'boklockTest' do
  # Ensure the test target can find React/Pods headers (e.g. React/RCTLog.h).
  inherit! :complete
end
