# Set language and locale to UTF-8 to avoid encoding errors on Windows
ENV['LANG'] = 'en_US.UTF-8'
ENV['LC_ALL'] = 'en_US.UTF-8'

# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

require 'pathname'

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

# 读取环境变量（从项目根目录）
def load_env_file(env_type)
  # 优先使用 build.sh 传入的 ENVFILE（例如 .env.production / .env.development）
  # 然后把它拷贝成根目录 .env，确保 react-native-config 会读取到正确内容
  root_dir = File.expand_path('../../', __dir__)
  passed_env_file = ENV['ENVFILE']
  env_file = passed_env_file && !passed_env_file.to_s.strip.empty? ? passed_env_file : (env_type == 'dev' ? '.env.dev' : '.env.real')

  abs_env_file =
    if Pathname.new(env_file).absolute?
      env_file
    else
      File.expand_path(env_file, root_dir)
    end

  # react-native-config 的 dotenv.gradle 会从 "$project.rootDir/../$envFile" 读取 env，
  # 其中 project.rootDir 通常是 android/app，所以最终会去 android/<envFile> 目录找。
  # 因此这里需要把 env 文件复制到 android/ 下（文件名保持一致）。
  android_dir = File.join(root_dir, 'android')
  target_env_android = File.join(android_dir, File.basename(abs_env_file))

  unless File.exist?(abs_env_file)
    UI.important("⚠️  环境文件不存在: #{abs_env_file}")
    return
  end

  # 确保 react-native-config 读取到正确 .env
  require 'fileutils'
  FileUtils.cp(abs_env_file, target_env_android)

  File.readlines(abs_env_file).each do |line|
      line.strip!
      next if line.empty? || line.start_with?('#')
      
      key, value = line.split('=', 2)
      next unless key && value
      
      ENV[key.strip] = value.strip.gsub(/^["']|["']$/, '')
  end

  UI.success("✅ 已加载环境配置: #{abs_env_file} -> #{target_env_android}")
end

platform :android do
  desc "dev"
  lane :dev do
    # 加载开发环境配置
    ENV['ENVFILE'] = '.env.development'
    load_env_file('dev')
    # sh("cd ../.. && cp .env.dev .env") 
    
    # 生成 codegen 文件（React Native 新架构需要，必须在构建前生成）
    UI.message("📦 生成 codegen 文件...")
    gradle(
      task: ":app:generateCodegenArtifactsFromSchema",
      properties: {
        "DEPLOY_VERSION" => ENV['DEPLOY_VERSION'],
        "DEPLOY_ENV" => ENV['DEPLOY_ENV'],
        # 强制 react-native-config 使用指定 env 文件，避免 flavor 推断/ENVFILE 失效回退到默认 dev
        "defaultEnvFile" => ".env.development"
      }
    )
    
    # 构建 APK（不执行 clean，避免删除 codegen 文件）
    gradle(
      task: "assembleDevRelease",
      properties: {
        "DEPLOY_VERSION" => ENV['DEPLOY_VERSION'],
        "DEPLOY_ENV" => ENV['DEPLOY_ENV'],
        "defaultEnvFile" => ".env.development"
      },
      flags: "--no-daemon -DENVFILE=.env.development"
    )

    # 确保上传的是本次 dev flavor 的 apk（避免 fastlane/pgyer 抓到旧包）
    apk_path = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH] || nil
    if !apk_path
      project_root = File.expand_path('../../', __dir__)
      apk_candidates = Dir[
        File.join(
          project_root,
          'android',
          'app',
          'build',
          'outputs',
          'apk',
          'dev',
          'release',
          '*.apk'
        )
      ]
      apk_path = apk_candidates.max_by { |f| File.mtime(f) } if apk_candidates.any?
    end
    
    # 上传到蒲公英（插件会自动查找 APK，并通过签名自动识别证书）
    api_key = ENV['PGYER_API_KEY'] || '5974674521be3a02a72a22e0a4e87105'
    install_type = ENV['PGYER_INSTALL_TYPE'] || '1'
    UI.user_error!("未找到 dev release APK，请检查 app/build/outputs/apk/dev/release") unless apk_path
    pgyer(api_key: api_key, install_type: install_type.to_s, apk: apk_path)
  end

  desc "real"
  lane :real do
    # 加载生产环境配置
    ENV['ENVFILE'] = '.env.production'
    load_env_file('real')
    # sh("cd ../.. && cp .env.real .env")
    
    # 生成 codegen 文件（React Native 新架构需要，必须在构建前生成）
    UI.message("📦 生成 codegen 文件...")
    gradle(
      task: ":app:generateCodegenArtifactsFromSchema",
      properties: {
        "DEPLOY_VERSION" => ENV['DEPLOY_VERSION'],
        "DEPLOY_ENV" => ENV['DEPLOY_ENV'],
        "defaultEnvFile" => ".env.production"
      }
    )
    
    # 构建 APK（不执行 clean，避免删除 codegen 文件）
    gradle(
      task: "assembleProdRelease",
      properties: {
        "DEPLOY_VERSION" => ENV['DEPLOY_VERSION'],
        "DEPLOY_ENV" => ENV['DEPLOY_ENV'],
        "defaultEnvFile" => ".env.production"
      },
      flags: "--no-daemon -DENVFILE=.env.production"
    )

    # 确保上传的是本次 prod flavor 的 apk（避免 fastlane/pgyer 抓到旧包）
    apk_path = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH] || nil
    if !apk_path
      project_root = File.expand_path('../../', __dir__)
      apk_candidates = Dir[
        File.join(
          project_root,
          'android',
          'app',
          'build',
          'outputs',
          'apk',
          'prod',
          'release',
          '*.apk'
        )
      ]
      apk_path = apk_candidates.max_by { |f| File.mtime(f) } if apk_candidates.any?
    end
    
    # 上传到蒲公英（插件会自动查找 APK，并通过签名自动识别证书）
    api_key = ENV['PGYER_API_KEY'] || '5974674521be3a02a72a22e0a4e87105'
    install_type = ENV['PGYER_INSTALL_TYPE'] || '1'
    UI.user_error!("未找到 prod release APK，请检查 app/build/outputs/apk/prod/release") unless apk_path
    pgyer(api_key: api_key, install_type: install_type.to_s, apk: apk_path)
  end

  desc "Upload dev build to Pgyer"
  lane :upload_to_pgyer_dev do
    load_env_file('dev')
    api_key = ENV['PGYER_API_KEY'] || '5974674521be3a02a72a22e0a4e87105'
    install_type = ENV['PGYER_INSTALL_TYPE'] || '1'
    direct = ENV['FASTLANE_APK_PATH']
    if direct && File.exist?(direct)
      apk_path = direct
    else
    bases = [
      File.join('app', 'build', 'outputs', 'apk'),
      File.join('app', 'build', 'outputs')
    ]
    candidates = []
    bases.each do |b|
      [
        File.join(b, 'dev', 'release', '*.apk'),
        File.join(b, 'dev', '*.apk'),
        File.join(b, 'release', '*.apk'),
        File.join(b, '*.apk'),
        File.join(b, '**', '*.apk')
      ].each { |g| candidates.concat(Dir[g.gsub('\\', '/')]) }
    end
    apk_path = candidates.uniq.max_by { |f| File.mtime(f) } if candidates.any?
    end
    UI.user_error!("未找到 APK 文件，请先完成 Gradle 构建或检查输出目录 app/build/outputs") unless apk_path
    pgyer(api_key: api_key, install_type: install_type.to_s, apk: apk_path)
  end

  desc "Upload real build to Pgyer"
  lane :upload_to_pgyer_real do
    load_env_file('real')
    api_key = ENV['PGYER_API_KEY'] || '5974674521be3a02a72a22e0a4e87105'
    install_type = ENV['PGYER_INSTALL_TYPE'] || '1'
    direct = ENV['FASTLANE_APK_PATH']
    if direct && File.exist?(direct)
      apk_path = direct
    else
    bases = [
      File.join('app', 'build', 'outputs', 'apk'),
      File.join('app', 'build', 'outputs')
    ]
    candidates = []
    bases.each do |b|
      [
        File.join(b, 'real', 'release', '*.apk'),
        File.join(b, 'real', '*.apk'),
        File.join(b, 'release', '*.apk'),
        File.join(b, '*.apk'),
        File.join(b, '**', '*.apk')
      ].each { |g| candidates.concat(Dir[g.gsub('\\', '/')]) }
    end
    apk_path = candidates.uniq.max_by { |f| File.mtime(f) } if candidates.any?
    end
    UI.user_error!("未找到 APK 文件，请先完成 Gradle 构建或检查输出目录 app/build/outputs") unless apk_path
    pgyer(api_key: api_key, install_type: install_type.to_s, apk: apk_path)
  end

  desc "清理构建产物（安全清理，先生成 codegen 再清理）"
  lane :clean do
    # 先生成 codegen 文件，避免 CMake clean 时报错
    UI.message("📦 生成 codegen 文件（clean 需要）...")
    gradle(task: ":app:generateCodegenArtifactsFromSchema")
    
    # 然后执行 clean
    UI.message("🧹 清理构建产物...")
    gradle(task: "clean")
    
    UI.success("✅ 清理完成")
  end
end
